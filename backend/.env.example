PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/campusx
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Google Gemini API Configuration for AI Listing Assistant & Content Safety
# Obtain an API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Security & Rate Limiting (Optional overrides)
# GLOBAL_RATE_LIMIT_WINDOW_MS=900000
# GLOBAL_RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=5
# AI_RATE_LIMIT_WINDOW_MS=600000
# AI_RATE_LIMIT_MAX=10
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# CHAT_RATE_LIMIT_MAX=60
# PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
# PASSWORD_RESET_RATE_LIMIT_MAX=5
# MAX_FAILED_LOGIN_ATTEMPTS=5
# LOCKOUT_DURATION_MS=900000

